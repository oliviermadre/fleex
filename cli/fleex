#!/usr/bin/env bash
#
# fleex — Local dev-stack manager
#
# Supports multiple concurrent instances via git worktrees.
# Each instance gets its own dynamically-allocated ports.
#
set -euo pipefail

# ── Paths ──────────────────────────────────────────────────────────────────────
FLEEX_HOME="${FLEEX_HOME:-$HOME/.fleex}"
DEFAULT_REPO_DIR="$FLEEX_HOME/repo"

# ── Colors ─────────────────────────────────────────────────────────────────────
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'

# ── Helpers ────────────────────────────────────────────────────────────────────
info()  { printf "${BLUE}[fleex]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[fleex]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[fleex]${NC} %s\n" "$*"; }
err()   { printf "${RED}[fleex]${NC} %s\n" "$*" >&2; }
die()   { err "$@"; exit 1; }

# ── Instance detection (worktree-aware) ────────────────────────────────────────
#
# If CWD is inside a git worktree that contains packages/server, use it.
# Otherwise fall back to ~/.fleex/repo.
#
resolve_instance() {
  local git_toplevel
  git_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"

  if [[ -n "$git_toplevel" && -d "$git_toplevel/packages/server" && -d "$git_toplevel/packages/web" ]]; then
    REPO_DIR="$git_toplevel"
  else
    REPO_DIR="$DEFAULT_REPO_DIR"
  fi

  # Derive a stable instance slug from the branch name (or directory hash)
  local branch
  branch="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "default")"
  INSTANCE_SLUG="$(echo "$branch" | sed 's/[^a-zA-Z0-9._-]/-/g')"

  # Per-instance directories
  INSTANCE_RUN="$FLEEX_HOME/.run/$INSTANCE_SLUG"
  INSTANCE_LOG="$FLEEX_HOME/.logs/$INSTANCE_SLUG"
  PORTS_FILE="$INSTANCE_RUN/ports.json"
}

ensure_dirs() {
  mkdir -p "$INSTANCE_RUN" "$INSTANCE_LOG"
}

# ── Prerequisite checks ───────────────────────────────────────────────────────
check_bun() {
  command -v bun >/dev/null 2>&1 || die "bun is required but not installed. Install it: https://bun.sh"
}

check_repo() {
  [[ -d "$REPO_DIR/packages" ]] || die "Repo not found at $REPO_DIR. Run the installer or cd into a worktree."
}

# ── Port allocation ───────────────────────────────────────────────────────────
SERVICES=(gateway server web)

find_free_port() {
  local port
  # Try to find a free port using a temporary socket
  if command -v python3 >/dev/null 2>&1; then
    port="$(python3 -c '
import socket
s = socket.socket()
s.bind(("", 0))
print(s.getsockname()[1])
s.close()
')"
  elif command -v python >/dev/null 2>&1; then
    port="$(python -c '
import socket
s = socket.socket()
s.bind(("", 0))
print(s.getsockname()[1])
s.close()
')"
  else
    # Fallback: scan for a free port in the ephemeral range
    for port in $(shuf -i 10000-60000 -n 50); do
      if ! (echo >/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
        echo "$port"
        return
      fi
    done
    die "Could not find a free port."
  fi
  echo "$port"
}

allocate_ports() {
  local p_gateway p_server p_web
  p_gateway="$(find_free_port)"
  p_server="$(find_free_port)"
  p_web="$(find_free_port)"

  # Persist for status/stop/logs
  cat > "$PORTS_FILE" <<JSON
{"gateway":$p_gateway,"server":$p_server,"web":$p_web}
JSON

  PORT_GATEWAY="$p_gateway"
  PORT_SERVER="$p_server"
  PORT_WEB="$p_web"
}

load_ports() {
  if [[ ! -f "$PORTS_FILE" ]]; then
    return 1
  fi
  PORT_GATEWAY="$(sed -n 's/.*"gateway":\([0-9]*\).*/\1/p' "$PORTS_FILE")"
  PORT_SERVER="$(sed -n 's/.*"server":\([0-9]*\).*/\1/p' "$PORTS_FILE")"
  PORT_WEB="$(sed -n 's/.*"web":\([0-9]*\).*/\1/p' "$PORTS_FILE")"
}

# ── PID management ─────────────────────────────────────────────────────────────
pid_file()   { echo "$INSTANCE_RUN/$1.pid"; }
log_file()   { echo "$INSTANCE_LOG/$1.log"; }

is_running() {
  local pf
  pf="$(pid_file "$1")"
  [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null
}

save_pid()   { echo "$2" > "$(pid_file "$1")"; }
remove_pid() { rm -f "$(pid_file "$1")"; }

_kill_tree() {
  local pid="$1" sig="${2:-TERM}"
  local children
  children="$(pgrep -P "$pid" 2>/dev/null || true)"
  for child in $children; do
    _kill_tree "$child" "$sig"
  done
  kill -"$sig" "$pid" 2>/dev/null || true
}

# ── Commands ───────────────────────────────────────────────────────────────────

cmd_start() {
  # Parse --port flag
  local FORCED_WEB_PORT=""
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)
        [[ -n "${2:-}" ]] || die "Missing value for --port"
        if ! [[ "$2" =~ ^[0-9]+$ ]] || (( $2 < 1 || $2 > 65535 )); then
          die "Invalid port number: $2 (must be 1-65535)"
        fi
        FORCED_WEB_PORT="$2"
        shift 2
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  set -- "${args[@]+${args[@]}}"

  check_bun
  check_repo
  ensure_dirs

  # Check if this instance is already running
  local already_running=false
  for svc in "${SERVICES[@]}"; do
    if is_running "$svc"; then
      already_running=true
    fi
  done

  if $already_running; then
    warn "Instance '$INSTANCE_SLUG' is already running. Use 'fleex restart' to restart."
    cmd_status
    return 0
  fi

  info "Installing dependencies..."
  (cd "$REPO_DIR" && bun install --frozen-lockfile 2>/dev/null || bun install) > "$(log_file install)" 2>&1
  ok "Dependencies installed."

  # Allocate dynamic ports
  allocate_ports

  # Override web port if --port was specified
  if [[ -n "$FORCED_WEB_PORT" ]]; then
    PORT_WEB="$FORCED_WEB_PORT"
    cat > "$PORTS_FILE" <<JSON
{"gateway":$PORT_GATEWAY,"server":$PORT_SERVER,"web":$PORT_WEB}
JSON
  fi

  info "Allocated ports — gateway:$PORT_GATEWAY  server:$PORT_SERVER  web:$PORT_WEB"

  # Load project .env if present (set -a exports all vars to subprocesses)
  if [ -f "$REPO_DIR/.env" ]; then
    set -a
    . "$REPO_DIR/.env"
    set +a
  fi

  info "Starting stack for ${BOLD}$INSTANCE_SLUG${NC}..."

  # Enable job control so each background job gets its own process group (PGID = PID).
  # This makes `kill -- -$pid` reliably kill the entire group on stop.
  set -m

  # Gateway
  (cd "$REPO_DIR" && \
    GATEWAY_PORT="$PORT_GATEWAY" \
    FLEEX_CENTRAL_URL="http://localhost:$PORT_SERVER" \
    bun run dev:gateway \
  ) < /dev/null > "$(log_file gateway)" 2>&1 &
  save_pid gateway $!

  # Server
  (cd "$REPO_DIR" && \
    PORT="$PORT_SERVER" \
    HOST_GATEWAY_URL="http://localhost:$PORT_GATEWAY" \
    FLEEX_STORAGE_DRIVER="${FLEEX_STORAGE_DRIVER:-json}" \
    bun run dev:server \
  ) < /dev/null > "$(log_file server)" 2>&1 &
  save_pid server $!

  # Web (Vite)
  (cd "$REPO_DIR" && \
    VITE_DEV_PORT="$PORT_WEB" \
    VITE_PROXY_TARGET="http://localhost:$PORT_SERVER" \
    bun run dev:web \
  ) < /dev/null > "$(log_file web)" 2>&1 &
  save_pid web $!

  set +m

  sleep 1

  echo ""
  ok "Stack started! [$INSTANCE_SLUG]"
  echo ""
  printf "  ${CYAN}%-10s${NC} ${DIM}%-30s${NC} %s\n" "Service" "URL" "Log"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "gateway" "http://localhost:$PORT_GATEWAY" "$(log_file gateway)"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "server"  "http://localhost:$PORT_SERVER"  "$(log_file server)"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "web"     "http://localhost:$PORT_WEB"     "$(log_file web)"
  echo ""
  info "Use ${BOLD}fleex status${NC} to check, ${BOLD}fleex stop${NC} to shut down."
}

cmd_stop() {
  if [[ "${1:-}" == "--all" ]]; then
    _stop_all_instances
  elif [[ -n "${1:-}" ]]; then
    # Named instance — validate it exists
    local target="$1"
    local target_run="$FLEEX_HOME/.run/$target"
    if [[ ! -d "$target_run" ]]; then
      die "Unknown instance '$target'. Use 'fleex status' to list instances."
    fi
    _stop_instance "$target"
  else
    ensure_dirs
    _stop_instance "$INSTANCE_SLUG"
  fi
}

_stop_instance() {
  local slug="$1"
  local run_dir="$FLEEX_HOME/.run/$slug"
  local stopped=0

  for svc in "${SERVICES[@]}"; do
    local pf="$run_dir/$svc.pid"
    if [[ -f "$pf" ]]; then
      local pid
      pid="$(cat "$pf")"
      if kill -0 "$pid" 2>/dev/null; then
        # 1) Process-group kill (works when set -m was active at spawn time)
        kill -- -"$pid" 2>/dev/null || true
        # 2) Recursive tree kill as fallback for any escapees
        _kill_tree "$pid" TERM
        # 3) Brief wait, then SIGKILL escalation for anything that survived
        sleep 0.2
        if kill -0 "$pid" 2>/dev/null; then
          kill -- -"$pid" 9 2>/dev/null || true
          _kill_tree "$pid" KILL
        fi
        info "[$slug] Stopped $svc (PID $pid)"
        stopped=$((stopped + 1))
      fi
      rm -f "$pf"
    fi
  done

  # Clean up ports file
  rm -f "$run_dir/ports.json"

  if [[ $stopped -eq 0 ]]; then
    warn "[$slug] No services were running."
  else
    ok "[$slug] All services stopped."
  fi
}

_stop_all_instances() {
  local run_base="$FLEEX_HOME/.run"
  if [[ ! -d "$run_base" ]]; then
    warn "No instances found."
    return
  fi

  local found=false
  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    found=true
    local slug
    slug="$(basename "$dir")"
    _stop_instance "$slug"
  done

  if ! $found; then
    warn "No instances found."
  fi
}

cmd_remove() {
  if [[ "${1:-}" == "--all-stopped" ]]; then
    _remove_all_stopped
    return
  fi

  local target="${1:-$INSTANCE_SLUG}"
  local target_run="$FLEEX_HOME/.run/$target"
  local target_log="$FLEEX_HOME/.logs/$target"

  if [[ ! -d "$target_run" && ! -d "$target_log" ]]; then
    die "Unknown instance '$target'. Use 'fleex status' to list instances."
  fi

  # Refuse to remove a running instance
  for svc in "${SERVICES[@]}"; do
    local pf="$target_run/$svc.pid"
    if [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null; then
      die "Instance '$target' is still running. Stop it first: fleex stop $target"
    fi
  done

  rm -rf "$target_run" "$target_log"
  ok "Removed instance '$target'"
}

_remove_all_stopped() {
  local run_base="$FLEEX_HOME/.run"
  [[ -d "$run_base" ]] || { warn "No instances found."; return; }

  local removed=0
  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    local slug
    slug="$(basename "$dir")"

    # Skip if any service is running
    local running=false
    for svc in "${SERVICES[@]}"; do
      local pf="$dir/$svc.pid"
      if [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null; then
        running=true
        break
      fi
    done
    $running && continue

    rm -rf "$FLEEX_HOME/.run/$slug" "$FLEEX_HOME/.logs/$slug"
    ok "Removed instance '$slug'"
    removed=$((removed + 1))
  done

  if [[ $removed -eq 0 ]]; then
    warn "No stopped instances to remove."
  else
    ok "Removed $removed stopped instance(s)."
  fi
}

cmd_restart() {
  info "Restarting stack..."
  cmd_stop
  sleep 1
  cmd_start "$@"
}

cmd_status() {
  local run_base="$FLEEX_HOME/.run"

  echo ""
  printf "  ${BOLD}fleex stack status${NC}\n"
  echo ""

  if [[ ! -d "$run_base" ]] || [[ -z "$(ls -A "$run_base" 2>/dev/null)" ]]; then
    printf "  ${DIM}No instances found.${NC}\n\n"
    return
  fi

  # Compute max instance name width dynamically
  local max_iw=8  # minimum: length of "Instance"
  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    local slug w
    slug="$(basename "$dir")"
    w=${#slug}
    [[ "$slug" == "$INSTANCE_SLUG" ]] && w=$((w + 2))  # account for " *"
    (( w > max_iw )) && max_iw=$w
  done

  # Header
  printf "  ${CYAN}%-${max_iw}s${NC}  %-10s  %-10s  %-8s  %s\n" "Instance" "Service" "Status" "PID" "URL"
  # Divider
  local dash_i; printf -v dash_i '%*s' "$max_iw" ''; dash_i="${dash_i// /─}"
  printf "  %s  %s  %s  %s  %s\n" "$dash_i" "──────────" "──────────" "────────" "─────────────────────────"

  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    local slug
    slug="$(basename "$dir")"

    local ports_file="$dir/ports.json"
    local p_gw="" p_srv="" p_web=""
    if [[ -f "$ports_file" ]]; then
      p_gw="$(sed -n 's/.*"gateway":\([0-9]*\).*/\1/p' "$ports_file")"
      p_srv="$(sed -n 's/.*"server":\([0-9]*\).*/\1/p' "$ports_file")"
      p_web="$(sed -n 's/.*"web":\([0-9]*\).*/\1/p' "$ports_file")"
    fi

    local is_current=""
    if [[ "$slug" == "$INSTANCE_SLUG" ]]; then
      is_current=" *"
    fi

    for svc in "${SERVICES[@]}"; do
      local pf="$dir/$svc.pid"
      local status_text status_color pid_label port_label inst_label

      local port_val
      case "$svc" in
        gateway) port_val="${p_gw:-}" ;;
        server)  port_val="${p_srv:-}" ;;
        web)     port_val="${p_web:-}" ;;
      esac
      port_label="${port_val:+http://localhost:$port_val}"
      port_label="${port_label:--}"

      # Only show instance name on first service row
      if [[ "$svc" == "gateway" ]]; then
        inst_label="${slug}${is_current}"
      else
        inst_label=""
      fi

      if [[ -f "$pf" ]]; then
        local pid
        pid="$(cat "$pf")"
        if kill -0 "$pid" 2>/dev/null; then
          status_text="running"
          status_color="$GREEN"
          pid_label="$pid"
        else
          status_text="dead"
          status_color="$RED"
          pid_label="-"
        fi
      else
        status_text="stopped"
        status_color="$DIM"
        pid_label="-"
      fi

      printf "  %-${max_iw}s  ${CYAN}%-10s${NC}  ${status_color}%-10s${NC}  %-8s  %s\n" "$inst_label" "$svc" "$status_text" "$pid_label" "$port_label"
    done
    echo ""
  done

  printf "  ${DIM}Logs: $FLEEX_HOME/.logs/<instance>/${NC}\n"
  printf "  ${DIM}Current instance: $INSTANCE_SLUG${NC}\n"
  printf "  ${DIM}Source: $REPO_DIR${NC}\n"
  echo ""
}

cmd_self_update() {
  local update_dir="$DEFAULT_REPO_DIR"
  [[ -d "$update_dir/.git" ]] || die "Default repo not found at $update_dir. Nothing to update."

  info "Updating fleex..."

  (cd "$update_dir" && git pull --rebase origin main 2>/dev/null || git pull origin main)
  ok "Code updated."

  check_bun
  info "Reinstalling dependencies..."
  (cd "$update_dir" && bun install) > "$FLEEX_HOME/.logs/self-update.log" 2>&1
  ok "Dependencies updated."

  # Run pending database migrations
  local env_file="$update_dir/.env"
  if [[ -f "$env_file" ]]; then
    info "Running database migrations..."
    (
      set -a
      . "$env_file"
      set +a
      FLEEX_SQLITE_PATH="${FLEEX_SQLITE_PATH:-$FLEEX_HOME/fleex.db}" \
      bun run "$update_dir/packages/server/src/infrastructure/migrations/cli-migrate.ts"
    ) >> "$FLEEX_HOME/.logs/self-update.log" 2>&1 && ok "Migrations applied." || warn "Migration check completed (see logs for details)."
  fi

  # Ensure symlink is in place (in case user installed with an older version that copied)
  local cli_src="$update_dir/cli/fleex"
  local cli_dst="$FLEEX_HOME/bin/fleex"
  if [[ -f "$cli_src" ]]; then
    chmod +x "$cli_src"
    if [[ ! -L "$cli_dst" ]]; then
      ln -sf "$cli_src" "$cli_dst"
      ok "CLI re-linked (was a copy, now a symlink)."
    fi
  fi

  echo ""
  ok "fleex is up to date!"
  warn "Running instances are not affected. Restart them if needed: ${BOLD}fleex restart${NC}"
}

cmd_logs() {
  ensure_dirs
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    local lf
    lf="$(log_file "$svc")"
    [[ -f "$lf" ]] || die "No log file for '$svc' in instance '$INSTANCE_SLUG'."
    tail -f "$lf"
  else
    tail -f "$INSTANCE_LOG"/*.log
  fi
}

cmd_help() {
  cat <<EOF

  ${BOLD}${CYAN}fleex${NC} — Local dev-stack manager (multi-instance)

  ${BOLD}${YELLOW}Usage:${NC}
    fleex <command> [options]

  ${BOLD}${YELLOW}Commands:${NC}
    ${CYAN}start${NC} [--port <port>]  Start all services (gateway, server, web)
    ${CYAN}stop${NC} [name]    Stop the current instance (or a named one)
    ${CYAN}stop --all${NC}    Stop ALL running instances
    ${CYAN}remove${NC} [name]         Remove a stopped instance (run + logs)
    ${CYAN}remove --all-stopped${NC}  Remove ALL stopped instances
    ${CYAN}restart${NC}       Restart the current instance
    ${CYAN}status${NC}        Show status of all instances
    ${CYAN}logs${NC} [svc]    Tail logs (all services, or a specific one)
    ${CYAN}self-update${NC}   Pull latest code and update CLI
    ${CYAN}help${NC}          Show this help message

  ${BOLD}${YELLOW}Multi-instance:${NC}
    fleex is worktree-aware. Run ${BOLD}fleex start${NC} from different git worktrees
    to start multiple isolated instances with their own ports.

    Ports are allocated dynamically — no conflicts, ever.

  ${BOLD}${YELLOW}Services:${NC}
    ${CYAN}gateway${NC}       Host gateway          ${DIM}(dynamic port)${NC}
    ${CYAN}server${NC}        API server (Fastify)   ${DIM}(dynamic port)${NC}
    ${CYAN}web${NC}           Frontend (Vite)        ${DIM}(dynamic port)${NC}

  ${BOLD}${YELLOW}Paths:${NC}
    ${DIM}Home${NC}          ~/.fleex/
    ${DIM}Default repo${NC}  ~/.fleex/repo/
    ${DIM}Instances${NC}     ~/.fleex/.run/<branch>/
    ${DIM}Logs${NC}          ~/.fleex/.logs/<branch>/

  ${BOLD}${YELLOW}Options:${NC}
    ${CYAN}--port <port>${NC}  Force the web (Vite) service to use a specific port

  ${BOLD}${YELLOW}Examples:${NC}
    ${GREEN}fleex start${NC}               Start the stack (current worktree or default)
    ${GREEN}fleex start --port 3000${NC}   Start with web on port 3000
    ${GREEN}fleex status${NC}              Show all running instances
    ${GREEN}fleex logs server${NC}          Follow server logs for current instance
    ${GREEN}fleex stop${NC}                Stop current instance
    ${GREEN}fleex stop --all${NC}          Stop everything
    ${GREEN}fleex self-update${NC}         Update to latest version

EOF
}

# ── Main dispatch ──────────────────────────────────────────────────────────────

main() {
  # Resolve instance context before any command
  resolve_instance

  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    start)       cmd_start "$@" ;;
    stop)        cmd_stop "$@" ;;
    remove)      cmd_remove "$@" ;;
    restart)     cmd_restart "$@" ;;
    status)      cmd_status "$@" ;;
    logs)        cmd_logs "$@" ;;
    self-update) cmd_self_update "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
      err "Unknown command: $cmd"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
