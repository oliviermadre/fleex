    ${GREEN}fleex stop --all${NC}          Stop everything
    ${GREEN}fleex self-update${NC}         Update to latest version

EOF
}

# ── Main dispatch ──────────────────────────────────────────────────────────────

main() {
  # Resolve instance context before any command
  resolve_instance

  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    start)       cmd_start "$@" ;;
    stop)        cmd_stop "$@" ;;
    remove)      cmd_remove "$@" ;;
    restart)     cmd_restart "$@" ;;
    desktop)     cmd_desktop "$@" ;;
    status)      cmd_status "$@" ;;
    logs)        cmd_logs "$@" ;;
    ticket|t)    cmd_ticket "$@" ;;
    epic|e)      cmd_epic "$@" ;;
    doctor)      cmd_doctor "$@" ;;
    self-update) cmd_self_update "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
      err "Unknown command: $cmd"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
