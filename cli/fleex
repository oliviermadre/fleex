#!/usr/bin/env bash
#
# fleex — Local dev-stack manager for Agent Session Manager
#
set -euo pipefail

# ── Paths ──────────────────────────────────────────────────────────────────────
FLEEX_HOME="${FLEEX_HOME:-$HOME/.fleex}"
FLEEX_RUN="$FLEEX_HOME/.run"
FLEEX_LOG="$FLEEX_HOME/.logs"
REPO_DIR="$FLEEX_HOME/repo"

# ── Colors ─────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Helpers ────────────────────────────────────────────────────────────────────
info()  { printf "${BLUE}[fleex]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[fleex]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[fleex]${NC} %s\n" "$*"; }
err()   { printf "${RED}[fleex]${NC} %s\n" "$*" >&2; }
die()   { err "$@"; exit 1; }

ensure_dirs() {
  mkdir -p "$FLEEX_RUN" "$FLEEX_LOG"
}

# ── Prerequisite checks ───────────────────────────────────────────────────────
check_bun() {
  command -v bun >/dev/null 2>&1 || die "bun is required but not installed. Install it: https://bun.sh"
}

check_repo() {
  [[ -d "$REPO_DIR/packages" ]] || die "Repo not found at $REPO_DIR. Run the installer again."
}

# ── PID management ─────────────────────────────────────────────────────────────
SERVICES=(gateway server web)

pid_file() { echo "$FLEEX_RUN/$1.pid"; }
log_file() { echo "$FLEEX_LOG/$1.log"; }

is_running() {
  local pf
  pf="$(pid_file "$1")"
  [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null
}

save_pid() { echo "$2" > "$(pid_file "$1")"; }

remove_pid() { rm -f "$(pid_file "$1")"; }

# ── Commands ───────────────────────────────────────────────────────────────────

cmd_start() {
  check_bun
  check_repo
  ensure_dirs

  # Check if already running
  local already_running=false
  for svc in "${SERVICES[@]}"; do
    if is_running "$svc"; then
      already_running=true
    fi
  done

  if $already_running; then
    warn "Some services are already running. Use 'fleex restart' to restart."
    cmd_status
    return 0
  fi

  info "Installing dependencies..."
  (cd "$REPO_DIR" && bun install --frozen-lockfile 2>/dev/null || bun install) > "$(log_file install)" 2>&1
  ok "Dependencies installed."

  info "Starting the stack..."

  # Gateway (bun, port 3001)
  (cd "$REPO_DIR" && bun run dev:gateway) > "$(log_file gateway)" 2>&1 &
  save_pid gateway $!

  # Server (tsx, port 3000)
  (cd "$REPO_DIR" && bun run dev:server) > "$(log_file server)" 2>&1 &
  save_pid server $!

  # Web / Vite (port 5173)
  (cd "$REPO_DIR" && bun run dev:web) > "$(log_file web)" 2>&1 &
  save_pid web $!

  # Give processes a moment to start
  sleep 1

  echo ""
  ok "Stack started!"
  echo ""
  printf "  ${CYAN}%-10s${NC} ${DIM}%-30s${NC} %s\n" "Service" "URL" "Log"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "gateway" "http://localhost:3001" "$(log_file gateway)"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "server"  "http://localhost:3000" "$(log_file server)"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "web"     "http://localhost:5173" "$(log_file web)"
  echo ""
  info "Use ${BOLD}fleex status${NC} to check, ${BOLD}fleex stop${NC} to shut down."
  info "Logs: ${BOLD}tail -f $FLEEX_LOG/*.log${NC}"
}

cmd_stop() {
  ensure_dirs
  local stopped=0

  for svc in "${SERVICES[@]}"; do
    local pf
    pf="$(pid_file "$svc")"
    if [[ -f "$pf" ]]; then
      local pid
      pid="$(cat "$pf")"
      if kill -0 "$pid" 2>/dev/null; then
        # Kill the process group to catch child processes
        kill -- -"$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
        info "Stopped $svc (PID $pid)"
        stopped=$((stopped + 1))
      fi
      remove_pid "$svc"
    fi
  done

  if [[ $stopped -eq 0 ]]; then
    warn "No services were running."
  else
    ok "All services stopped."
  fi
}

cmd_restart() {
  info "Restarting stack..."
  cmd_stop
  sleep 1
  cmd_start
}

cmd_status() {
  ensure_dirs

  echo ""
  printf "  ${BOLD}fleex stack status${NC}\n"
  echo ""
  printf "  ${CYAN}%-10s${NC}  %-12s  %-8s  %s\n" "Service" "Status" "PID" "Port"
  printf "  %-10s  %-12s  %-8s  %s\n" "───────" "──────" "───" "────"

  for svc in "${SERVICES[@]}"; do
    local pf pid status_label pid_label port
    pf="$(pid_file "$svc")"

    case "$svc" in
      gateway) port="3001" ;;
      server)  port="3000" ;;
      web)     port="5173" ;;
    esac

    if [[ -f "$pf" ]]; then
      pid="$(cat "$pf")"
      if kill -0 "$pid" 2>/dev/null; then
        status_label="${GREEN}running${NC}"
        pid_label="$pid"
      else
        status_label="${RED}dead${NC}"
        pid_label="-"
        remove_pid "$svc"
      fi
    else
      status_label="${DIM}stopped${NC}"
      pid_label="-"
    fi

    printf "  ${CYAN}%-10s${NC}  ${status_label}%-5s  %-8s  %s\n" "$svc" "" "$pid_label" "$port"
  done
  echo ""
  printf "  ${DIM}Logs:${NC} $FLEEX_LOG/\n"
  printf "  ${DIM}Repo:${NC} $REPO_DIR\n"
  echo ""
}

cmd_self_update() {
  check_repo
  info "Updating fleex..."

  # Pull latest code
  (cd "$REPO_DIR" && git pull --rebase origin main 2>/dev/null || git pull origin main)
  ok "Code updated."

  # Reinstall dependencies
  check_bun
  info "Reinstalling dependencies..."
  (cd "$REPO_DIR" && bun install) > "$(log_file install)" 2>&1
  ok "Dependencies updated."

  # Reinstall CLI
  local cli_src="$REPO_DIR/cli/fleex"
  local cli_dst="$FLEEX_HOME/bin/fleex"
  if [[ -f "$cli_src" ]]; then
    cp "$cli_src" "$cli_dst"
    chmod +x "$cli_dst"
    ok "CLI binary updated."
  fi

  echo ""
  ok "fleex is up to date!"
  warn "If the stack is running, restart it: ${BOLD}fleex restart${NC}"
}

cmd_logs() {
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    local lf
    lf="$(log_file "$svc")"
    [[ -f "$lf" ]] || die "No log file for '$svc'."
    tail -f "$lf"
  else
    tail -f "$FLEEX_LOG"/*.log
  fi
}

cmd_help() {
  cat <<EOF

  ${BOLD}fleex${NC} — Local dev-stack manager

  ${BOLD}Usage:${NC}
    fleex <command>

  ${BOLD}Commands:${NC}
    start         Start all services (gateway, server, web)
    stop          Stop all running services
    restart       Restart all services
    status        Show the status of each service
    logs [svc]    Tail logs (all services, or a specific one)
    self-update   Pull latest code and update CLI
    help          Show this help message

  ${BOLD}Services:${NC}
    gateway       Host gateway         http://localhost:3001
    server        API server (Fastify)  http://localhost:3000
    web           Frontend (Vite)       http://localhost:5173

  ${BOLD}Paths:${NC}
    Installation  ~/.fleex/
    Repo          ~/.fleex/repo/
    Logs          ~/.fleex/.logs/
    PID files     ~/.fleex/.run/

  ${BOLD}Examples:${NC}
    fleex start               Start the full stack
    fleex logs server          Follow server logs
    fleex self-update          Update to latest version
    fleex restart              Restart everything

EOF
}

# ── Main dispatch ──────────────────────────────────────────────────────────────

main() {
  local cmd="${1:-help}"
  shift 2>/dev/null || true

  case "$cmd" in
    start)       cmd_start "$@" ;;
    stop)        cmd_stop "$@" ;;
    restart)     cmd_restart "$@" ;;
    status)      cmd_status "$@" ;;
    logs)        cmd_logs "$@" ;;
    self-update) cmd_self_update "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
      err "Unknown command: $cmd"
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
