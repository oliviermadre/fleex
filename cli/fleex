#!/usr/bin/env bash
#
# fleex — Local dev-stack manager
#
# Supports multiple concurrent instances via git worktrees.
# Each instance gets its own dynamically-allocated ports.
#
set -euo pipefail

# ── Paths ──────────────────────────────────────────────────────────────────────
FLEEX_HOME="${FLEEX_HOME:-$HOME/.fleex}"
DEFAULT_REPO_DIR="$FLEEX_HOME/repo"

# ── Colors ─────────────────────────────────────────────────────────────────────
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
DIM=$'\033[2m'
NC=$'\033[0m'

# ── Helpers ────────────────────────────────────────────────────────────────────
info()  { printf "${BLUE}[fleex]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[fleex]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[fleex]${NC} %s\n" "$*"; }
err()   { printf "${RED}[fleex]${NC} %s\n" "$*" >&2; }
die()   { err "$@"; exit 1; }

# ── API helpers ───────────────────────────────────────────────────────────────

_check_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is required for ticket commands. Install it: https://formulae.brew.sh/formula/jq"
}

_api_base() {
  load_ports || die "Stack not running. Start it with: fleex start"
  echo "http://localhost:$PORT_SERVER"
}

_api_get() {
  local url="$1"
  local response http_code body
  response="$(curl -s -w '\n%{http_code}' --max-time 10 "$url" 2>/dev/null)" || die "API request failed: GET $url (connection error)"
  http_code="$(echo "$response" | tail -1)"
  body="$(echo "$response" | sed '$d')"
  if [[ ! "$http_code" =~ ^2 ]]; then
    local msg
    msg="$(echo "$body" | jq -r '.message // .error // empty' 2>/dev/null || true)"
    die "API error (HTTP $http_code): ${msg:-$body}"
  fi
  echo "$body"
}

_api_post() {
  local url="$1" body="$2"
  local response http_code resp_body
  response="$(curl -s -w '\n%{http_code}' --max-time 10 -X POST -H "Content-Type: application/json" -d "$body" "$url" 2>/dev/null)" \
    || die "API request failed: POST $url (connection error)"
  http_code="$(echo "$response" | tail -1)"
  resp_body="$(echo "$response" | sed '$d')"
  if [[ ! "$http_code" =~ ^2 ]]; then
    local msg
    msg="$(echo "$resp_body" | jq -r '.message // .error // empty' 2>/dev/null || true)"
    die "API error (HTTP $http_code): ${msg:-$resp_body}"
  fi
  echo "$resp_body"
}

_api_patch() {
  local url="$1" body="$2"
  local response http_code resp_body
  response="$(curl -s -w '\n%{http_code}' --max-time 10 -X PATCH -H "Content-Type: application/json" -d "$body" "$url" 2>/dev/null)" \
    || die "API request failed: PATCH $url (connection error)"
  http_code="$(echo "$response" | tail -1)"
  resp_body="$(echo "$response" | sed '$d')"
  if [[ ! "$http_code" =~ ^2 ]]; then
    local msg
    msg="$(echo "$resp_body" | jq -r '.message // .error // empty' 2>/dev/null || true)"
    die "API error (HTTP $http_code): ${msg:-$resp_body}"
  fi
  echo "$resp_body"
}

_api_delete() {
  local url="$1"
  local http_code
  http_code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -X DELETE "$url" 2>/dev/null)" \
    || die "API request failed: DELETE $url (connection error)"
  if [[ ! "$http_code" =~ ^2 ]]; then
    die "API error (HTTP $http_code)"
  fi
}

# ── Ticket resolution helpers ─────────────────────────────────────────────────

# Resolve a display ID or UUID to a ticket UUID.
# Usage: _resolve_ticket_id <input> [board_id]
_resolve_ticket_id() {
  local input="${1#\#}"  # strip leading # if present
  local board_id="${2:-}"
  local base; base="$(_api_base)"

  # UUID detection
  if [[ "$input" == *-* && ${#input} -ge 36 ]]; then
    echo "$input"
    return
  fi

  # Must be numeric displayId
  if ! [[ "$input" =~ ^[0-9]+$ ]]; then
    die "Invalid ticket ID: $input (use a display ID number or UUID)"
  fi

  local url="$base/api/tickets"
  [[ -n "$board_id" ]] && url="$url?boardId=$board_id"

  local tickets; tickets="$(_api_get "$url")"

  local matches; matches="$(echo "$tickets" | jq --argjson did "$input" '[.[] | select(.displayId == $did)]')"
  local count; count="$(echo "$matches" | jq 'length')"

  if [[ "$count" -eq 0 ]]; then
    die "No ticket found with display ID #$input"
  elif [[ "$count" -eq 1 ]]; then
    echo "$matches" | jq -r '.[0].id'
    return
  fi

  # Multiple matches — fetch boards to show names
  local boards; boards="$(_api_get "$base/api/boards")"

  err "There are $count tickets with the id $input, consider using the --board flag"
  printf "${BLUE}[fleex]${NC} Tickets found:\n" >&2
  echo "$matches" | jq -r --argjson boards "$boards" '
    .[] | . as $t |
    ($boards | map(select(.id == $t.boardId)) | .[0].name // "Unknown") as $boardName |
    "- \($t.title) - Board \($boardName) (uuid = \($t.boardId))"
  ' | while IFS= read -r line; do
    printf "  %s\n" "$line" >&2
  done
  exit 1
}

# Resolve board ID: if specified use it, if only one board auto-select, otherwise error.
_resolve_board_id() {
  local specified="$1"
  local base; base="$(_api_base)"

  if [[ -n "$specified" ]]; then
    echo "$specified"
    return
  fi

  local boards; boards="$(_api_get "$base/api/boards")"
  local count; count="$(echo "$boards" | jq 'length')"

  if [[ "$count" -eq 0 ]]; then
    die "No boards found. Create one in the web UI first."
  elif [[ "$count" -eq 1 ]]; then
    echo "$boards" | jq -r '.[0].id'
    return
  fi

  err "Multiple boards found. Specify one with --board ID:"
  echo "$boards" | jq -r '.[] | "  \(.id)  \(.emoji) \(.name)"' >&2
  exit 1
}

# Measure the terminal display width of a string (handles emoji/unicode)
_display_width() {
  python3 -c "
import unicodedata, sys
s = sys.argv[1]
w = 0
for ch in s:
    cat = unicodedata.category(ch)
    if cat in ('Mn', 'Me', 'Cf'):
        pass
    elif unicodedata.east_asian_width(ch) in ('W', 'F'):
        w += 2
    else:
        w += 1
print(w)
" "$1"
}

# Return the ANSI color code for a ticket status
_status_color_code() {
  case "$1" in
    done)      printf "%s" "$GREEN" ;;
    doing)     printf "%s" "$YELLOW" ;;
    reviewing) printf "%s" "$CYAN" ;;
    todo)      printf "%s" "$BLUE" ;;
    cancelled) printf "%s" "$RED" ;;
    backlog)   printf "%s" "$DIM" ;;
    *)         ;;
  esac
}

# Print a status string with color applied
_status_color() {
  local color; color="$(_status_color_code "$1")"
  printf "%s%s%s" "$color" "$1" "$NC"
}

# ── Instance detection (worktree-aware) ────────────────────────────────────────
#
# If CWD is inside a git worktree that contains packages/server, use it.
# Otherwise fall back to ~/.fleex/repo.
#
resolve_instance() {
  local git_toplevel
  git_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || true)"

  if [[ -n "$git_toplevel" && -d "$git_toplevel/packages/server" && -d "$git_toplevel/packages/web" ]]; then
    REPO_DIR="$git_toplevel"
  else
    REPO_DIR="$DEFAULT_REPO_DIR"
  fi

  # Derive a stable instance slug from the branch name (or directory hash)
  local branch
  branch="$(git -C "$REPO_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "default")"
  INSTANCE_SLUG="$(echo "$branch" | sed 's/[^a-zA-Z0-9._-]/-/g')"

  # Per-instance directories
  INSTANCE_RUN="$FLEEX_HOME/.run/$INSTANCE_SLUG"
  INSTANCE_LOG="$FLEEX_HOME/.logs/$INSTANCE_SLUG"
  PORTS_FILE="$INSTANCE_RUN/ports.json"
}

ensure_dirs() {
  mkdir -p "$INSTANCE_RUN" "$INSTANCE_LOG"
}

# ── Version helpers ───────────────────────────────────────────────────────────
# Bash 3.x-compatible semver comparison: returns 0 if $1 >= $2
version_gte() {
  local IFS=.
  local i a=($1) b=($2)
  for ((i=0; i<${#b[@]}; i++)); do
    local va="${a[i]:-0}" vb="${b[i]:-0}"
    if (( va > vb )); then return 0; fi
    if (( va < vb )); then return 1; fi
  done
  return 0
}

MIN_BUN_VERSION="1.3.5"

# ── Prerequisite checks ───────────────────────────────────────────────────────
check_bun() {
  command -v bun >/dev/null 2>&1 || die "bun is required but not installed. Install it: https://bun.sh"
  local bun_ver
  bun_ver="$(bun --version 2>/dev/null)"
  if ! version_gte "$bun_ver" "$MIN_BUN_VERSION"; then
    die "bun $bun_ver is too old. fleex requires bun >= $MIN_BUN_VERSION (for Bun.spawn terminal support).
  Upgrade: bun upgrade"
  fi
}

check_repo() {
  [[ -d "$REPO_DIR/packages" ]] || die "Repo not found at $REPO_DIR. Run the installer or cd into a worktree."
}

# ── Port allocation ───────────────────────────────────────────────────────────
SERVICES=(gateway server web desktop)

find_free_port() {
  local port
  # Try to find a free port using a temporary socket
  if command -v python3 >/dev/null 2>&1; then
    port="$(python3 -c '
import socket
s = socket.socket()
s.bind(("", 0))
print(s.getsockname()[1])
s.close()
')"
  elif command -v python >/dev/null 2>&1; then
    port="$(python -c '
import socket
s = socket.socket()
s.bind(("", 0))
print(s.getsockname()[1])
s.close()
')"
  else
    # Fallback: scan for a free port in the ephemeral range
    for port in $(shuf -i 10000-60000 -n 50); do
      if ! (echo >/dev/tcp/127.0.0.1/"$port") 2>/dev/null; then
        echo "$port"
        return
      fi
    done
    die "Could not find a free port."
  fi
  echo "$port"
}

allocate_ports() {
  local p_gateway p_server p_web
  p_gateway="$(find_free_port)"
  p_server="$(find_free_port)"
  p_web="$(find_free_port)"

  # Persist for status/stop/logs
  cat > "$PORTS_FILE" <<JSON
{"gateway":$p_gateway,"server":$p_server,"web":$p_web}
JSON

  PORT_GATEWAY="$p_gateway"
  PORT_SERVER="$p_server"
  PORT_WEB="$p_web"
}

load_ports() {
  if [[ ! -f "$PORTS_FILE" ]]; then
    return 1
  fi
  PORT_GATEWAY="$(sed -n 's/.*"gateway":\([0-9]*\).*/\1/p' "$PORTS_FILE")"
  PORT_SERVER="$(sed -n 's/.*"server":\([0-9]*\).*/\1/p' "$PORTS_FILE")"
  PORT_WEB="$(sed -n 's/.*"web":\([0-9]*\).*/\1/p' "$PORTS_FILE")"
}

# ── PID management ─────────────────────────────────────────────────────────────
pid_file()   { echo "$INSTANCE_RUN/$1.pid"; }
log_file()   { echo "$INSTANCE_LOG/$1.log"; }

is_running() {
  local pf
  pf="$(pid_file "$1")"
  [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null
}

save_pid()   { echo "$2" > "$(pid_file "$1")"; }
remove_pid() { rm -f "$(pid_file "$1")"; }

_kill_tree() {
  local pid="$1" sig="${2:-TERM}"
  local children
  children="$(pgrep -P "$pid" 2>/dev/null || true)"
  for child in $children; do
    _kill_tree "$child" "$sig"
  done
  kill -"$sig" "$pid" 2>/dev/null || true
}

# ── Health check ──────────────────────────────────────────────────────────────
# Polls an HTTP endpoint until it responds 2xx, or times out.
# Usage: _wait_for_service <name> <url> <pid> <logfile> <timeout_secs>
_wait_for_service() {
  local name="$1" url="$2" pid="$3" logfile="$4" timeout="${5:-15}"
  local elapsed=0
  while (( elapsed < timeout )); do
    # If process died, fail immediately
    if ! kill -0 "$pid" 2>/dev/null; then
      err "$name exited unexpectedly. Last 15 lines of log:"
      tail -15 "$logfile" 2>/dev/null | while IFS= read -r line; do
        printf "  ${DIM}%s${NC}\n" "$line"
      done
      return 1
    fi
    # Probe the endpoint
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$url" 2>/dev/null || echo "000")"
    if [[ "$code" =~ ^2 ]]; then
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  err "$name did not become healthy within ${timeout}s (last HTTP $code). Last 15 lines of log:"
  tail -15 "$logfile" 2>/dev/null | while IFS= read -r line; do
    printf "  ${DIM}%s${NC}\n" "$line"
  done
  return 1
}

# ── Commands ───────────────────────────────────────────────────────────────────

cmd_start() {
  # Parse --port and --desktop flags
  local FORCED_WEB_PORT=""
  local DESKTOP_MODE=false
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)
        [[ -n "${2:-}" ]] || die "Missing value for --port"
        if ! [[ "$2" =~ ^[0-9]+$ ]] || (( $2 < 1 || $2 > 65535 )); then
          die "Invalid port number: $2 (must be 1-65535)"
        fi
        FORCED_WEB_PORT="$2"
        shift 2
        ;;
      --desktop)
        DESKTOP_MODE=true
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done
  set -- "${args[@]+${args[@]}}"

  check_bun
  check_repo
  ensure_dirs

  # Check if this instance is already running
  local already_running=false
  for svc in "${SERVICES[@]}"; do
    if is_running "$svc"; then
      already_running=true
    fi
  done

  if $already_running; then
    warn "Instance '$INSTANCE_SLUG' is already running. Use 'fleex restart' to restart."
    cmd_status
    return 0
  fi

  info "Installing dependencies..."
  (cd "$REPO_DIR" && bun install --frozen-lockfile 2>/dev/null || bun install) > "$(log_file install)" 2>&1
  ok "Dependencies installed."

  # Allocate dynamic ports
  allocate_ports

  # Override web port if --port was specified
  if [[ -n "$FORCED_WEB_PORT" ]]; then
    PORT_WEB="$FORCED_WEB_PORT"
    cat > "$PORTS_FILE" <<JSON
{"gateway":$PORT_GATEWAY,"server":$PORT_SERVER,"web":$PORT_WEB}
JSON
  fi

  info "Allocated ports — gateway:$PORT_GATEWAY  server:$PORT_SERVER  web:$PORT_WEB"

  # Load project .env if present (set -a exports all vars to subprocesses)
  if [ -f "$REPO_DIR/.env" ]; then
    set -a
    . "$REPO_DIR/.env"
    set +a
  fi

  info "Starting stack for ${BOLD}$INSTANCE_SLUG${NC}..."

  # Enable job control so each background job gets its own process group (PGID = PID).
  # This makes `kill -- -$pid` reliably kill the entire group on stop.
  set -m

  # Gateway
  (cd "$REPO_DIR" && \
    GATEWAY_PORT="$PORT_GATEWAY" \
    FLEEX_CENTRAL_URL="http://localhost:$PORT_SERVER" \
    bun run dev:gateway \
  ) < /dev/null > "$(log_file gateway)" 2>&1 &
  save_pid gateway $!

  # Server
  (cd "$REPO_DIR" && \
    PORT="$PORT_SERVER" \
    HOST_GATEWAY_URL="http://localhost:$PORT_GATEWAY" \
    FLEEX_STORAGE_DRIVER="${FLEEX_STORAGE_DRIVER:-json}" \
    bun run dev:server \
  ) < /dev/null > "$(log_file server)" 2>&1 &
  save_pid server $!

  # Web (Vite)
  (cd "$REPO_DIR" && \
    VITE_DEV_PORT="$PORT_WEB" \
    VITE_PROXY_TARGET="http://localhost:$PORT_SERVER" \
    bun run dev:web \
  ) < /dev/null > "$(log_file web)" 2>&1 &
  save_pid web $!

  set +m

  # Health check: wait for all services to respond
  info "Waiting for services to become healthy..."
  local health_ok=true

  _wait_for_service "gateway" "http://localhost:$PORT_GATEWAY/health" \
    "$(cat "$(pid_file gateway)")" "$(log_file gateway)" 15 || health_ok=false

  if $health_ok; then
    _wait_for_service "server" "http://localhost:$PORT_SERVER/health" \
      "$(cat "$(pid_file server)")" "$(log_file server)" 15 || health_ok=false
  fi

  if $health_ok; then
    _wait_for_service "web" "http://localhost:$PORT_WEB/" \
      "$(cat "$(pid_file web)")" "$(log_file web)" 15 || health_ok=false
  fi

  echo ""
  if $health_ok; then
    ok "Stack started! [$INSTANCE_SLUG]"
  else
    warn "Stack started with issues — some services may not be healthy. [$INSTANCE_SLUG]"
  fi
  echo ""
  printf "  ${CYAN}%-10s${NC} ${DIM}%-30s${NC} %s\n" "Service" "URL" "Log"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "gateway" "http://localhost:$PORT_GATEWAY" "$(log_file gateway)"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "server"  "http://localhost:$PORT_SERVER"  "$(log_file server)"
  printf "  ${CYAN}%-10s${NC} %-30s ${DIM}%s${NC}\n" "web"     "http://localhost:$PORT_WEB"     "$(log_file web)"
  echo ""
  info "Use ${BOLD}fleex status${NC} to check, ${BOLD}fleex stop${NC} to shut down."

  # Launch Electron desktop window if --desktop was passed
  if $DESKTOP_MODE; then
    _launch_desktop
  fi
}

# ── Desktop launcher (shared by cmd_start --desktop and cmd_desktop) ──────────
_launch_desktop() {
  local desktop_dir="$REPO_DIR/packages/desktop"
  local electron_bin="$desktop_dir/node_modules/.bin/electron"
  if [[ ! -d "$desktop_dir" ]]; then
    warn "packages/desktop not found."
    return 1
  fi
  if [[ ! -x "$electron_bin" ]]; then
    info "Installing desktop dependencies..."
    (cd "$desktop_dir" && bun install) > "$(log_file desktop-install)" 2>&1
    if [[ ! -x "$electron_bin" ]]; then
      warn "Failed to install Electron. Check $(log_file desktop-install)"
      return 1
    fi
    ok "Desktop dependencies installed."
  fi
  info "Opening Electron desktop window..."
  (cd "$REPO_DIR" && \
    FLEEX_SERVER_PORT="$PORT_WEB" \
    "$electron_bin" "$desktop_dir" \
  ) < /dev/null > "$(log_file desktop)" 2>&1 &
  save_pid desktop $!
  ok "Desktop window opened (PID $!)"
}

cmd_stop() {
  if [[ "${1:-}" == "--all" ]]; then
    _stop_all_instances
  elif [[ -n "${1:-}" ]]; then
    # Named instance — validate it exists
    local target="$1"
    local target_run="$FLEEX_HOME/.run/$target"
    if [[ ! -d "$target_run" ]]; then
      die "Unknown instance '$target'. Use 'fleex status' to list instances."
    fi
    _stop_instance "$target"
  else
    ensure_dirs
    _stop_instance "$INSTANCE_SLUG"
  fi
}

_stop_instance() {
  local slug="$1"
  local run_dir="$FLEEX_HOME/.run/$slug"
  local stopped=0

  for svc in "${SERVICES[@]}"; do
    local pf="$run_dir/$svc.pid"
    if [[ -f "$pf" ]]; then
      local pid
      pid="$(cat "$pf")"
      if kill -0 "$pid" 2>/dev/null; then
        # 1) Process-group kill (works when set -m was active at spawn time)
        kill -- -"$pid" 2>/dev/null || true
        # 2) Recursive tree kill as fallback for any escapees
        _kill_tree "$pid" TERM
        # 3) Brief wait, then SIGKILL escalation for anything that survived
        sleep 0.2
        if kill -0 "$pid" 2>/dev/null; then
          kill -- -"$pid" 9 2>/dev/null || true
          _kill_tree "$pid" KILL
        fi
        info "[$slug] Stopped $svc (PID $pid)"
        stopped=$((stopped + 1))
      fi
      rm -f "$pf"
    fi
  done

  # Clean up ports file
  rm -f "$run_dir/ports.json"

  if [[ $stopped -eq 0 ]]; then
    warn "[$slug] No services were running."
  else
    ok "[$slug] All services stopped."
  fi
}

_stop_all_instances() {
  local run_base="$FLEEX_HOME/.run"
  if [[ ! -d "$run_base" ]]; then
    warn "No instances found."
    return
  fi

  local found=false
  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    found=true
    local slug
    slug="$(basename "$dir")"
    _stop_instance "$slug"
  done

  if ! $found; then
    warn "No instances found."
  fi
}

cmd_remove() {
  if [[ "${1:-}" == "--all-stopped" ]]; then
    _remove_all_stopped
    return
  fi

  local target="${1:-$INSTANCE_SLUG}"
  local target_run="$FLEEX_HOME/.run/$target"
  local target_log="$FLEEX_HOME/.logs/$target"

  if [[ ! -d "$target_run" && ! -d "$target_log" ]]; then
    die "Unknown instance '$target'. Use 'fleex status' to list instances."
  fi

  # Refuse to remove a running instance
  for svc in "${SERVICES[@]}"; do
    local pf="$target_run/$svc.pid"
    if [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null; then
      die "Instance '$target' is still running. Stop it first: fleex stop $target"
    fi
  done

  rm -rf "$target_run" "$target_log"
  ok "Removed instance '$target'"
}

_remove_all_stopped() {
  local run_base="$FLEEX_HOME/.run"
  [[ -d "$run_base" ]] || { warn "No instances found."; return; }

  local removed=0
  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    local slug
    slug="$(basename "$dir")"

    # Skip if any service is running
    local running=false
    for svc in "${SERVICES[@]}"; do
      local pf="$dir/$svc.pid"
      if [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null; then
        running=true
        break
      fi
    done
    $running && continue

    rm -rf "$FLEEX_HOME/.run/$slug" "$FLEEX_HOME/.logs/$slug"
    ok "Removed instance '$slug'"
    removed=$((removed + 1))
  done

  if [[ $removed -eq 0 ]]; then
    warn "No stopped instances to remove."
  else
    ok "Removed $removed stopped instance(s)."
  fi
}

cmd_restart() {
  info "Restarting stack..."
  cmd_stop
  sleep 1
  cmd_start "$@"
}

cmd_desktop() {
  ensure_dirs
  # Try current instance first
  if load_ports 2>/dev/null && kill -0 "$(cat "$(pid_file server)" 2>/dev/null)" 2>/dev/null; then
    info "Attaching desktop to running instance [$INSTANCE_SLUG]..."
    _launch_desktop
    return
  fi

  # Scan for any running instance
  local run_base="$FLEEX_HOME/.run"
  local running_slugs=()
  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    local pf="$dir/server.pid"
    if [[ -f "$pf" ]] && kill -0 "$(cat "$pf")" 2>/dev/null; then
      running_slugs+=("$(basename "$dir")")
    fi
  done

  if [[ ${#running_slugs[@]} -eq 1 ]]; then
    local target="${running_slugs[0]}"
    info "Found running instance: $target"
    INSTANCE_SLUG="$target"
    INSTANCE_RUN="$FLEEX_HOME/.run/$INSTANCE_SLUG"
    INSTANCE_LOG="$FLEEX_HOME/.logs/$INSTANCE_SLUG"
    PORTS_FILE="$INSTANCE_RUN/ports.json"
    load_ports
    _launch_desktop
  elif [[ ${#running_slugs[@]} -gt 1 ]]; then
    warn "Multiple running instances found:"
    for s in "${running_slugs[@]}"; do
      printf "  - %s\n" "$s"
    done
    die "Stop other instances or specify which one to use."
  else
    info "No running instance found. Starting stack with desktop..."
    cmd_start --desktop "$@"
  fi
}

cmd_status() {
  local run_base="$FLEEX_HOME/.run"

  echo ""
  printf "  ${BOLD}fleex stack status${NC}\n"
  echo ""

  if [[ ! -d "$run_base" ]] || [[ -z "$(ls -A "$run_base" 2>/dev/null)" ]]; then
    printf "  ${DIM}No instances found.${NC}\n\n"
    return
  fi

  # Compute max instance name width dynamically
  local max_iw=8  # minimum: length of "Instance"
  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    local slug w
    slug="$(basename "$dir")"
    w=${#slug}
    [[ "$slug" == "$INSTANCE_SLUG" ]] && w=$((w + 2))  # account for " *"
    (( w > max_iw )) && max_iw=$w
  done

  # Header
  printf "  ${CYAN}%-${max_iw}s${NC}  %-10s  %-10s  %-8s  %s\n" "Instance" "Service" "Status" "PID" "URL"
  # Divider
  local dash_i; printf -v dash_i '%*s' "$max_iw" ''; dash_i="${dash_i// /─}"
  printf "  %s  %s  %s  %s  %s\n" "$dash_i" "──────────" "──────────" "────────" "─────────────────────────"

  for dir in "$run_base"/*/; do
    [[ -d "$dir" ]] || continue
    local slug
    slug="$(basename "$dir")"

    local ports_file="$dir/ports.json"
    local p_gw="" p_srv="" p_web=""
    if [[ -f "$ports_file" ]]; then
      p_gw="$(sed -n 's/.*"gateway":\([0-9]*\).*/\1/p' "$ports_file")"
      p_srv="$(sed -n 's/.*"server":\([0-9]*\).*/\1/p' "$ports_file")"
      p_web="$(sed -n 's/.*"web":\([0-9]*\).*/\1/p' "$ports_file")"
    fi

    local is_current=""
    if [[ "$slug" == "$INSTANCE_SLUG" ]]; then
      is_current=" *"
    fi

    for svc in "${SERVICES[@]}"; do
      local pf="$dir/$svc.pid"
      local status_text status_color pid_label port_label inst_label

      local port_val
      case "$svc" in
        gateway) port_val="${p_gw:-}" ;;
        server)  port_val="${p_srv:-}" ;;
        web)     port_val="${p_web:-}" ;;
      esac
      port_label="${port_val:+http://localhost:$port_val}"
      port_label="${port_label:--}"

      # Only show instance name on first service row
      if [[ "$svc" == "gateway" ]]; then
        inst_label="${slug}${is_current}"
      else
        inst_label=""
      fi

      if [[ -f "$pf" ]]; then
        local pid
        pid="$(cat "$pf")"
        if kill -0 "$pid" 2>/dev/null; then
          status_text="running"
          status_color="$GREEN"
          pid_label="$pid"
        else
          status_text="dead"
          status_color="$RED"
          pid_label="-"
        fi
      else
        status_text="stopped"
        status_color="$DIM"
        pid_label="-"
      fi

      printf "  %-${max_iw}s  ${CYAN}%-10s${NC}  ${status_color}%-10s${NC}  %-8s  %s\n" "$inst_label" "$svc" "$status_text" "$pid_label" "$port_label"
    done
    echo ""
  done

  printf "  ${DIM}Logs: $FLEEX_HOME/.logs/<instance>/${NC}\n"
  printf "  ${DIM}Current instance: $INSTANCE_SLUG${NC}\n"
  printf "  ${DIM}Source: $REPO_DIR${NC}\n"
  echo ""
}

cmd_self_update() {
  local update_dir="$DEFAULT_REPO_DIR"
  git -C "$update_dir" rev-parse --git-dir &>/dev/null || die "Default repo not found at $update_dir. Nothing to update."

  info "Updating fleex..."

  (cd "$update_dir" && git pull --rebase origin main 2>/dev/null || git pull origin main)
  ok "Code updated."

  check_bun
  info "Reinstalling dependencies..."
  (cd "$update_dir" && bun install) > "$FLEEX_HOME/.logs/self-update.log" 2>&1
  ok "Dependencies updated."

  info "Building packages..."
  (cd "$update_dir" && bun run build) >> "$FLEEX_HOME/.logs/self-update.log" 2>&1
  ok "Build complete."

  # Run pending database migrations
  local env_file="$update_dir/.env"
  if [[ -f "$env_file" ]]; then
    info "Running database migrations..."
    (
      set -a
      . "$env_file"
      set +a
      FLEEX_SQLITE_PATH="${FLEEX_SQLITE_PATH:-$FLEEX_HOME/fleex.db}" \
      bun run "$update_dir/packages/server/src/infrastructure/migrations/cli-migrate.ts"
    ) >> "$FLEEX_HOME/.logs/self-update.log" 2>&1 && ok "Migrations applied." || warn "Migration failed — check $FLEEX_HOME/.logs/self-update.log"
  fi

  # Ensure symlink is in place (in case user installed with an older version that copied)
  local cli_src="$update_dir/cli/fleex"
  local cli_dst="$FLEEX_HOME/bin/fleex"
  if [[ -f "$cli_src" ]]; then
    chmod +x "$cli_src"
    if [[ ! -L "$cli_dst" ]]; then
      ln -sf "$cli_src" "$cli_dst"
      ok "CLI re-linked (was a copy, now a symlink)."
    fi
  fi

  echo ""
  ok "fleex is up to date!"
  warn "Running instances are not affected. Restart them if needed: ${BOLD}fleex restart${NC}"
}

cmd_logs() {
  ensure_dirs
  local svc="${1:-}"
  if [[ -n "$svc" ]]; then
    local lf
    lf="$(log_file "$svc")"
    [[ -f "$lf" ]] || die "No log file for '$svc' in instance '$INSTANCE_SLUG'."
    tail -f "$lf"
  else
    tail -f "$INSTANCE_LOG"/*.log
  fi
}

cmd_doctor() {
  echo ""
  printf "  ${BOLD}fleex doctor${NC}\n"
  echo ""

  local all_ok=true

  # bun
  if command -v bun >/dev/null 2>&1; then
    local bun_ver
    bun_ver="$(bun --version 2>/dev/null)"
    if version_gte "$bun_ver" "$MIN_BUN_VERSION"; then
      printf "  ${GREEN}✓${NC} bun $bun_ver (>= $MIN_BUN_VERSION)\n"
    else
      printf "  ${RED}✗${NC} bun $bun_ver — too old, need >= $MIN_BUN_VERSION. Run: ${BOLD}bun upgrade${NC}\n"
      all_ok=false
    fi
  else
    printf "  ${RED}✗${NC} bun not found. Install: https://bun.sh\n"
    all_ok=false
  fi

  # tmux
  if command -v tmux >/dev/null 2>&1; then
    printf "  ${GREEN}✓${NC} tmux $(tmux -V 2>/dev/null | awk '{print $2}')\n"
  else
    printf "  ${RED}✗${NC} tmux not found\n"
    all_ok=false
  fi

  # claude
  if command -v claude >/dev/null 2>&1; then
    local claude_ver
    claude_ver="$(claude --version 2>/dev/null | awk '{print $1}')"
    if claude auth status 2>/dev/null | grep -q '"loggedIn"[[:space:]]*:[[:space:]]*true'; then
      printf "  ${GREEN}✓${NC} claude $claude_ver — authenticated\n"
    else
      printf "  ${YELLOW}⚠${NC} claude $claude_ver — not authenticated. Run: ${BOLD}claude auth login${NC}\n"
      all_ok=false
    fi
  else
    printf "  ${RED}✗${NC} claude CLI not found. Install: npm install -g @anthropic-ai/claude-code\n"
    all_ok=false
  fi

  # jq
  if command -v jq >/dev/null 2>&1; then
    printf "  ${GREEN}✓${NC} jq $(jq --version 2>/dev/null)\n"
  else
    printf "  ${RED}✗${NC} jq not found (required for ticket commands)\n"
    all_ok=false
  fi

  # gh
  if command -v gh >/dev/null 2>&1; then
    local gh_ver
    gh_ver="$(gh --version 2>/dev/null | head -1 | awk '{print $3}')"
    if gh auth status >/dev/null 2>&1; then
      printf "  ${GREEN}✓${NC} gh $gh_ver — authenticated\n"
    else
      printf "  ${YELLOW}⚠${NC} gh $gh_ver — not authenticated. Run: ${BOLD}gh auth login${NC}\n"
      all_ok=false
    fi
  else
    printf "  ${DIM}○${NC} gh not found (optional)\n"
  fi

  # Repo
  if [[ -d "$REPO_DIR/packages" ]]; then
    printf "  ${GREEN}✓${NC} repo found at $REPO_DIR\n"
  else
    printf "  ${RED}✗${NC} repo not found at $REPO_DIR\n"
    all_ok=false
  fi

  # node_modules
  if [[ -d "$REPO_DIR/node_modules" ]]; then
    printf "  ${GREEN}✓${NC} node_modules installed\n"
  else
    printf "  ${YELLOW}○${NC} node_modules missing — run: ${BOLD}cd $REPO_DIR && bun install${NC}\n"
  fi

  # Service health (only if instance is running)
  echo ""
  if load_ports 2>/dev/null; then
    printf "  ${BOLD}Services [$INSTANCE_SLUG]:${NC}\n"
    for svc in "${SERVICES[@]}"; do
      local port url
      case "$svc" in
        gateway) port="$PORT_GATEWAY"; url="http://localhost:$port/health" ;;
        server)  port="$PORT_SERVER";  url="http://localhost:$port/health" ;;
        web)     port="$PORT_WEB";     url="http://localhost:$port/" ;;
      esac

      if ! is_running "$svc"; then
        printf "  ${DIM}○${NC} $svc — not running\n"
        continue
      fi

      local code
      code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$url" 2>/dev/null || echo "000")"
      if [[ "$code" =~ ^2 ]]; then
        printf "  ${GREEN}✓${NC} $svc — healthy (HTTP $code on :$port)\n"
      else
        printf "  ${RED}✗${NC} $svc — unhealthy (HTTP $code on :$port)\n"
        all_ok=false
      fi
    done
  else
    printf "  ${DIM}No running instance found for $INSTANCE_SLUG${NC}\n"
  fi

  echo ""
  if $all_ok; then
    printf "  ${GREEN}${BOLD}All checks passed.${NC}\n"
  else
    printf "  ${YELLOW}${BOLD}Some checks failed — see above.${NC}\n"
  fi
  echo ""
}

# ── Ticket commands ────────────────────────────────────────────────────────────

VALID_STATUSES="backlog todo doing reviewing done cancelled"
VALID_PRIORITIES="none low medium high"

cmd_ticket() {
  _check_jq
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list|ls)       _ticket_list "$@" ;;
    show|view)     _ticket_show "$@" ;;
    create|new)    _ticket_create "$@" ;;
    update|edit)   _ticket_update "$@" ;;
    move|mv)       _ticket_move "$@" ;;
    delete|rm)     _ticket_delete "$@" ;;
    boards)        _ticket_boards "$@" ;;
    comment)       _ticket_comment "$@" ;;
    comments)      _ticket_comments "$@" ;;
    help|--help|-h) _ticket_help ;;
    *)
      err "Unknown ticket command: $subcmd"
      _ticket_help
      exit 1
      ;;
  esac
}

_ticket_list() {
  local board_id="" status="" tag="" epic_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board)  board_id="${2:?Missing value for --board}"; shift 2 ;;
      --status) status="${2:?Missing value for --status}"; shift 2 ;;
      --tag)    tag="${2:?Missing value for --tag}"; shift 2 ;;
      --epic)   epic_id="${2:?Missing value for --epic}"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  local base; base="$(_api_base)"
  local url="$base/api/tickets"
  local sep="?"
  if [[ -n "$board_id" ]]; then url="$url${sep}boardId=$board_id"; sep="&"; fi
  if [[ -n "$board_id" && -n "$status" ]]; then url="$url${sep}status=$status"; sep="&"; fi
  if [[ -n "$tag" ]]; then url="$url${sep}tag=$tag"; sep="&"; fi
  if [[ -n "$epic_id" ]]; then url="$url${sep}epicId=$epic_id"; sep="&"; fi

  local tickets; tickets="$(_api_get "$url")"

  # Server only filters by status when boardId is set, so filter client-side otherwise
  if [[ -n "$status" && -z "$board_id" ]]; then
    tickets="$(echo "$tickets" | jq --arg s "$status" '[.[] | select(.status == $s)]')"
  fi

  local count; count="$(echo "$tickets" | jq 'length')"

  if [[ "$count" -eq 0 ]]; then
    info "No tickets found."
    return
  fi

  # Fetch epics + memberships once, build ticketId -> "emoji name" map
  local epics_url="$base/api/epics"
  local memberships_url="$base/api/epics/memberships"
  if [[ -n "$board_id" ]]; then
    epics_url="$epics_url?boardId=$board_id"
    memberships_url="$memberships_url?boardId=$board_id"
  fi
  local epics; epics="$(_api_get "$epics_url")"
  local memberships; memberships="$(_api_get "$memberships_url")"

  # Enrich each ticket with an "epicLabel": first epic as "<emoji> <name>" (or "-")
  tickets="$(echo "$tickets" | jq \
    --argjson epics "$epics" \
    --argjson memberships "$memberships" '
    ($memberships | group_by(.ticketId) | map({key: .[0].ticketId, value: [.[].groupId]}) | from_entries) as $mbyT |
    ($epics | map({key: .id, value: ((.emoji // "") + (if .emoji then " " else "" end) + (.name // ""))}) | from_entries) as $ebyId |
    [.[] | . as $t |
      ($mbyT[$t.id] // []) as $gids |
      ($gids | map($ebyId[.]) | map(select(. != null and . != ""))) as $labels |
      . + {epicLabel: (if ($labels | length) == 0 then "-" else $labels[0] end)}
    ]
  ')"

  # When showing tickets across boards, add a Board column and sort by board then displayId
  local show_board=false
  if [[ -z "$board_id" ]]; then
    show_board=true
  fi

  echo ""
  if $show_board; then
    local boards; boards="$(_api_get "$base/api/boards")"
    # Sort by board name then displayId, join board name
    tickets="$(echo "$tickets" | jq --argjson boards "$boards" '
      [.[] | . as $t |
        ($boards | map(select(.id == $t.boardId)) | .[0].name // "Unknown") as $boardName |
        . + {boardName: $boardName}
      ] | sort_by(.boardName, .displayId)
    ')"

    printf "  ${BOLD}%-6s %-22s %-11s %-8s %-12s %-18s %s${NC}\n" "#" "Board" "Status" "Prio" "Assignee" "Epic" "Title"
    printf "  %-6s %-22s %-11s %-8s %-12s %-18s %s\n" "──────" "──────────────────────" "───────────" "────────" "────────────" "──────────────────" "──────────────────────────────"

    echo "$tickets" | jq -r '.[] | "\(.displayId)\t\(.boardName)\t\(.status)\t\(.priority)\t\(.assignee // "-")\t\(.epicLabel)\t\(.title)"' | \
    while IFS=$'\t' read -r did board_name status_val prio assignee epic_label title; do
      local padded_status; printf -v padded_status "%-11s" "$status_val"
      local color; color="$(_status_color_code "$status_val")"
      local short_epic="${epic_label:0:18}"
      printf "  %-6s %-22s %s%s%s %-8s %-12s %-18s %s\n" "#$did" "$board_name" "$color" "$padded_status" "$NC" "$prio" "$assignee" "$short_epic" "$title"
    done
  else
    # Single board: sort by displayId, no board column
    tickets="$(echo "$tickets" | jq 'sort_by(.displayId)')"

    printf "  ${BOLD}%-6s %-11s %-8s %-12s %-18s %s${NC}\n" "#" "Status" "Prio" "Assignee" "Epic" "Title"
    printf "  %-6s %-11s %-8s %-12s %-18s %s\n" "──────" "───────────" "────────" "────────────" "──────────────────" "──────────────────────────────"

    echo "$tickets" | jq -r '.[] | "\(.displayId)\t\(.status)\t\(.priority)\t\(.assignee // "-")\t\(.epicLabel)\t\(.title)"' | \
    while IFS=$'\t' read -r did status_val prio assignee epic_label title; do
      local padded_status; printf -v padded_status "%-11s" "$status_val"
      local color; color="$(_status_color_code "$status_val")"
      local short_epic="${epic_label:0:18}"
      printf "  %-6s %s%s%s %-8s %-12s %-18s %s\n" "#$did" "$color" "$padded_status" "$NC" "$prio" "$assignee" "$short_epic" "$title"
    done
  fi
  echo ""
  info "$count ticket(s)"
}
_ticket_show() {
  local ticket_id="" board_id="" with_comments=false with_deliverables=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board) board_id="${2:?Missing value for --board}"; shift 2 ;;
      --with-comments) with_comments=true; shift ;;
      --with-deliverables) with_deliverables=true; shift ;;
      --full) with_comments=true; with_deliverables=true; shift ;;
      *)
        if [[ -z "$ticket_id" ]]; then
          ticket_id="$1"; shift
        else
          die "Unknown option: $1"
        fi
        ;;
    esac
  done

  [[ -n "$ticket_id" ]] || die "Usage: fleex ticket show <id> [--board ID] [--with-comments] [--with-deliverables] [--full]"

  local uuid; uuid="$(_resolve_ticket_id "$ticket_id" "$board_id")"
  local base; base="$(_api_base)"
  local ticket; ticket="$(_api_get "$base/api/tickets/$uuid")"
  local ticket_epics; ticket_epics="$(_api_get "$base/api/tickets/$uuid/epics")"

  local title status_val priority assignee tags did description created updated due_date blocked favorite
  title="$(echo "$ticket" | jq -r '.title')"
  status_val="$(echo "$ticket" | jq -r '.status')"
  priority="$(echo "$ticket" | jq -r '.priority')"
  assignee="$(echo "$ticket" | jq -r '.assignee // "-"')"
  tags="$(echo "$ticket" | jq -r '(.tags // []) | if length == 0 then "-" else join(", ") end')"
  did="$(echo "$ticket" | jq -r '.displayId')"
  description="$(echo "$ticket" | jq -r '.description // ""')"
  created="$(echo "$ticket" | jq -r '.createdAt // "-"')"
  updated="$(echo "$ticket" | jq -r '.updatedAt // "-"')"
  due_date="$(echo "$ticket" | jq -r '.dueDate // "-"')"
  blocked="$(echo "$ticket" | jq -r '.blocked')"
  favorite="$(echo "$ticket" | jq -r '.favorite')"

  local epic_label
  epic_label="$(echo "$ticket_epics" | jq -r '
    if length == 0 then "-"
    else [.[] | (((.emoji // "") + (if .emoji then " " else "" end) + (.name // ""))) | select(. != "")] | join(", ")
    end
  ')"

  local colored_status; colored_status="$(_status_color "$status_val")"

  echo ""
  printf "  ${BOLD}Ticket #%s${NC}  %s | %s\n" "$did" "$colored_status" "$priority"
  printf "  %s\n" "─────────────────────────────────────────────────────────"
  printf "  ${BOLD}Title:${NC}       %s\n" "$title"
  printf "  ${BOLD}Assignee:${NC}    %s\n" "$assignee"
  printf "  ${BOLD}Tags:${NC}        %s\n" "$tags"
  printf "  ${BOLD}Epic:${NC}        %s\n" "$epic_label"
  printf "  ${BOLD}Blocked:${NC}     %s\n" "$blocked"
  printf "  ${BOLD}Favorite:${NC}    %s\n" "$favorite"
  printf "  ${BOLD}Due:${NC}         %s\n" "$due_date"
  printf "  ${BOLD}Created:${NC}     %s\n" "$created"
  printf "  ${BOLD}Updated:${NC}     %s\n" "$updated"
  printf "  ${BOLD}UUID:${NC}        ${DIM}%s${NC}\n" "$uuid"

  if [[ -n "$description" && "$description" != "null" && "$description" != "" ]]; then
    echo ""
    printf "  ${BOLD}Description:${NC}\n"
    echo "$description" | while IFS= read -r line; do
      printf "    %s\n" "$line"
    done
  fi

  # Show PRs (github_pr links) in their own section
  local prs_count; prs_count="$(echo "$ticket" | jq '[(.links // [])[] | select(.type == "github_pr")] | length')"
  if [[ "$prs_count" -gt 0 ]]; then
    echo ""
    printf "  ${BOLD}Pull Requests:${NC}\n"
    echo "$ticket" | jq -r '(.links // [])[] | select(.type == "github_pr") | "    \(.label) \(.url // "")"'
  fi

  # Show other links (non-github_pr)
  local links_count; links_count="$(echo "$ticket" | jq '[(.links // [])[] | select(.type != "github_pr")] | length')"
  if [[ "$links_count" -gt 0 ]]; then
    echo ""
    printf "  ${BOLD}Links:${NC}\n"
    echo "$ticket" | jq -r '(.links // [])[] | select(.type != "github_pr") | "    [\(.type)] \(.label) \(.url // .ref // "")"'
  fi

  # Show comments if requested
  if [[ "$with_comments" == "true" ]]; then
    local comments; comments="$(_api_get "$base/api/tickets/$uuid/comments")"
    local comments_count; comments_count="$(echo "$comments" | jq 'length')"

    echo ""
    printf "  ════════════════════════════════════════════════════════════\n"
    printf "  COMMENTS (%s)\n" "$comments_count"
    printf "  ════════════════════════════════════════════════════════════\n"

    if [[ "$comments_count" -gt 0 ]]; then
      local i=0
      while [[ "$i" -lt "$comments_count" ]]; do
        local author_type author_name created_at body
        author_type="$(echo "$comments" | jq -r ".[$i].authorType")"
        author_name="$(echo "$comments" | jq -r ".[$i].authorName")"
        created_at="$(echo "$comments" | jq -r ".[$i].createdAt")"
        body="$(echo "$comments" | jq -r ".[$i].body")"

        local color="$NC"
        [[ "$author_type" == "agent" ]] && color="$CYAN"
        [[ "$author_type" == "user" ]] && color="$GREEN"
        echo ""
        printf "    ${color}${BOLD}%s${NC} ${DIM}(%s)${NC}  ${DIM}%s${NC}\n" "$author_name" "$author_type" "$created_at"
        echo "$body" | while IFS= read -r line; do
          printf "      %s\n" "$line"
        done

        i=$((i + 1))
      done
    else
      echo ""
      printf "    ${DIM}No comments.${NC}\n"
    fi
  fi

  # Show deliverables if requested
  if [[ "$with_deliverables" == "true" ]]; then
    local deliverables; deliverables="$(_api_get "$base/api/tickets/$uuid/deliverables")"
    local deliv_count; deliv_count="$(echo "$deliverables" | jq 'length')"

    echo ""
    printf "  ════════════════════════════════════════════════════════════\n"
    printf "  DELIVERABLES (%s)\n" "$deliv_count"
    printf "  ════════════════════════════════════════════════════════════\n"

    if [[ "$deliv_count" -gt 0 ]]; then
      local i=0
      while [[ "$i" -lt "$deliv_count" ]]; do
        local d_title d_type d_agent d_status d_version d_content
        d_title="$(echo "$deliverables" | jq -r ".[$i].title")"
        d_type="$(echo "$deliverables" | jq -r ".[$i].type")"
        d_agent="$(echo "$deliverables" | jq -r ".[$i].agentName")"
        d_status="$(echo "$deliverables" | jq -r ".[$i].status")"
        d_version="$(echo "$deliverables" | jq -r ".[$i].version")"
        d_content="$(echo "$deliverables" | jq -r ".[$i].content")"

        local status_color="$YELLOW"
        [[ "$d_status" == "final" ]] && status_color="$GREEN"
        echo ""
        printf "    ${BOLD}%s${NC}  ${DIM}[%s]${NC}  by ${CYAN}%s${NC}  ${status_color}%s${NC}  ${DIM}v%s${NC}\n" \
          "$d_title" "$d_type" "$d_agent" "$d_status" "$d_version"
        printf "    ────────────────────────────────────────────────────────\n"
        echo "$d_content" | while IFS= read -r line; do
          printf "      %s\n" "$line"
        done

        i=$((i + 1))
      done
    else
      echo ""
      printf "    ${DIM}No deliverables.${NC}\n"
    fi
  fi

  echo ""
}

_ticket_create() {
  local board_id="" title="" description="" priority="" status="" tags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board)       board_id="${2:?Missing value for --board}"; shift 2 ;;
      --title)       title="${2:?Missing value for --title}"; shift 2 ;;
      --description) description="${2:?Missing value for --description}"; shift 2 ;;
      --priority)    priority="${2:?Missing value for --priority}"; shift 2 ;;
      --status)      status="${2:?Missing value for --status}"; shift 2 ;;
      --tag)         tags+=("${2:?Missing value for --tag}"); shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  [[ -n "$title" ]] || die "Usage: fleex ticket create --title \"...\" [--board ID] [--description \"...\"] [--priority P] [--status S] [--tag T]"

  board_id="$(_resolve_board_id "$board_id")"

  if [[ -n "$status" ]] && ! echo "$VALID_STATUSES" | grep -qw "$status"; then
    die "Invalid status: $status (valid: $VALID_STATUSES)"
  fi
  if [[ -n "$priority" ]] && ! echo "$VALID_PRIORITIES" | grep -qw "$priority"; then
    die "Invalid priority: $priority (valid: $VALID_PRIORITIES)"
  fi

  local base; base="$(_api_base)"

  # Build JSON body
  local body
  body="$(jq -n \
    --arg boardId "$board_id" \
    --arg title "$title" \
    --arg description "$description" \
    --arg priority "$priority" \
    --arg status "$status" \
    --argjson tags "$(printf '%s\n' "${tags[@]+"${tags[@]}"}" | jq -R . | jq -s .)" \
    '{boardId: $boardId, title: $title} +
     (if $description != "" then {description: $description} else {} end) +
     (if $priority != "" then {priority: $priority} else {} end) +
     (if $status != "" then {status: $status} else {} end) +
     (if ($tags | length) > 0 and ($tags | .[0] != "") then {tags: $tags} else {} end)'
  )"

  local result; result="$(_api_post "$base/api/tickets" "$body")"
  local did; did="$(echo "$result" | jq -r '.displayId')"
  local result_title; result_title="$(echo "$result" | jq -r '.title')"
  local result_status; result_status="$(echo "$result" | jq -r '.status')"

  ok "Created ticket #$did: $result_title ($result_status)"
}

_ticket_update() {
  local ticket_id="" board_id="" title="" description="" status="" priority="" assignee=""
  local has_updates=false

  # First positional arg is the ticket ID
  if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
    ticket_id="$1"; shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board)       board_id="${2:?Missing value for --board}"; shift 2 ;;
      --title)       title="${2:?Missing value for --title}"; has_updates=true; shift 2 ;;
      --description) description="${2:?Missing value for --description}"; has_updates=true; shift 2 ;;
      --status)      status="${2:?Missing value for --status}"; has_updates=true; shift 2 ;;
      --priority)    priority="${2:?Missing value for --priority}"; has_updates=true; shift 2 ;;
      --assignee)    assignee="${2:?Missing value for --assignee}"; has_updates=true; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  [[ -n "$ticket_id" ]] || die "Usage: fleex ticket update <id> [--title \"...\"] [--status S] [--priority P] [--assignee NAME]"
  $has_updates || die "No updates specified. Use --title, --description, --status, --priority, or --assignee."

  if [[ -n "$status" ]] && ! echo "$VALID_STATUSES" | grep -qw "$status"; then
    die "Invalid status: $status (valid: $VALID_STATUSES)"
  fi
  if [[ -n "$priority" ]] && ! echo "$VALID_PRIORITIES" | grep -qw "$priority"; then
    die "Invalid priority: $priority (valid: $VALID_PRIORITIES)"
  fi

  local uuid; uuid="$(_resolve_ticket_id "$ticket_id" "$board_id")"
  local base; base="$(_api_base)"

  local body
  body="$(jq -n \
    --arg title "$title" \
    --arg description "$description" \
    --arg status "$status" \
    --arg priority "$priority" \
    --arg assignee "$assignee" \
    '(if $title != "" then {title: $title} else {} end) +
     (if $description != "" then {description: $description} else {} end) +
     (if $status != "" then {status: $status} else {} end) +
     (if $priority != "" then {priority: $priority} else {} end) +
     (if $assignee != "" then {assignee: $assignee} else {} end)'
  )"

  local result; result="$(_api_patch "$base/api/tickets/$uuid" "$body")"
  local did; did="$(echo "$result" | jq -r '.displayId')"
  local result_title; result_title="$(echo "$result" | jq -r '.title')"

  ok "Updated ticket #$did: $result_title"
}

_ticket_move() {
  local ticket_id="" board_id="" target_status=""

  # Parse: <id> <status> [--board ID]
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board) board_id="${2:?Missing value for --board}"; shift 2 ;;
      *)
        if [[ -z "$ticket_id" ]]; then
          ticket_id="$1"
        elif [[ -z "$target_status" ]]; then
          target_status="$1"
        else
          die "Unknown option: $1"
        fi
        shift
        ;;
    esac
  done

  [[ -n "$ticket_id" && -n "$target_status" ]] || die "Usage: fleex ticket move <id> <status> [--board ID]"

  if ! echo "$VALID_STATUSES" | grep -qw "$target_status"; then
    die "Invalid status: $target_status (valid: $VALID_STATUSES)"
  fi

  local uuid; uuid="$(_resolve_ticket_id "$ticket_id" "$board_id")"
  local base; base="$(_api_base)"

  local body; body="$(jq -n --arg status "$target_status" '{status: $status}')"
  local result; result="$(_api_post "$base/api/tickets/$uuid/move" "$body")"
  local did; did="$(echo "$result" | jq -r '.displayId')"
  local new_status; new_status="$(echo "$result" | jq -r '.status')"

  ok "Moved ticket #$did to $new_status"
}

_ticket_delete() {
  local ticket_id="" board_id="" force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board) board_id="${2:?Missing value for --board}"; shift 2 ;;
      -f|--force) force=true; shift ;;
      *)
        if [[ -z "$ticket_id" ]]; then
          ticket_id="$1"; shift
        else
          die "Unknown option: $1"
        fi
        ;;
    esac
  done

  [[ -n "$ticket_id" ]] || die "Usage: fleex ticket delete <id> [-f] [--board ID]"

  local uuid; uuid="$(_resolve_ticket_id "$ticket_id" "$board_id")"
  local base; base="$(_api_base)"

  if ! $force; then
    # Fetch ticket title for confirmation
    local ticket; ticket="$(_api_get "$base/api/tickets/$uuid")"
    local title; title="$(echo "$ticket" | jq -r '.title')"
    local did; did="$(echo "$ticket" | jq -r '.displayId')"

    printf "${YELLOW}[fleex]${NC} Delete ticket #%s \"%s\"? [y/N] " "$did" "$title"
    local confirm
    read -r confirm
    if [[ ! "$confirm" =~ ^[yY] ]]; then
      info "Cancelled."
      return
    fi
  fi

  _api_delete "$base/api/tickets/$uuid"
  ok "Deleted ticket"
}

_ticket_boards() {
  local base; base="$(_api_base)"
  local boards; boards="$(_api_get "$base/api/boards")"
  local count; count="$(echo "$boards" | jq 'length')"

  if [[ "$count" -eq 0 ]]; then
    info "No boards found."
    return
  fi

  echo ""
  printf "  ${BOLD}%-26s %7s %6s %6s %6s %6s %6s  %s${NC}\n" "Board" "Backlog" "Todo" "Doing" "Review" "Done" "Canc." "ID"
  printf "  %-26s %7s %6s %6s %6s %6s %6s  %s\n" "──────────────────────────" "───────" "──────" "──────" "──────" "──────" "──────" "────────────────────────────────────"

  echo "$boards" | jq -r '.[] |
    "\(.emoji) \(.name)\t\(.ticketCounts.backlog // 0)\t\(.ticketCounts.todo // 0)\t\(.ticketCounts.doing // 0)\t\(.ticketCounts.reviewing // 0)\t\(.ticketCounts.done // 0)\t\(.ticketCounts.cancelled // 0)\t\(.id)"
  ' | while IFS=$'\t' read -r label cnt_backlog cnt_todo cnt_doing cnt_reviewing cnt_done cnt_cancelled bid; do
    local dw; dw="$(_display_width "$label")"
    local pad=$(( 26 - dw ))
    (( pad < 0 )) && pad=0
    printf "  %s%*s %7s %6s %6s %6s %6s %6s  ${DIM}%s${NC}\n" "$label" "$pad" "" "$cnt_backlog" "$cnt_todo" "$cnt_doing" "$cnt_reviewing" "$cnt_done" "$cnt_cancelled" "$bid"
  done
  echo ""
}

_ticket_comment() {
  local ticket_id="" board_id="" body=""

  # Parse: <id> "body" [--board ID]
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board) board_id="${2:?Missing value for --board}"; shift 2 ;;
      *)
        if [[ -z "$ticket_id" ]]; then
          ticket_id="$1"
        elif [[ -z "$body" ]]; then
          body="$1"
        else
          die "Unknown option: $1"
        fi
        shift
        ;;
    esac
  done

  [[ -n "$ticket_id" && -n "$body" ]] || die "Usage: fleex ticket comment <id> \"body\" [--board ID]"

  local uuid; uuid="$(_resolve_ticket_id "$ticket_id" "$board_id")"
  local base; base="$(_api_base)"

  local json_body; json_body="$(jq -n --arg body "$body" '{body: $body}')"
  _api_post "$base/api/tickets/$uuid/comments" "$json_body" > /dev/null

  ok "Comment added to ticket #$ticket_id"
}

_ticket_comments() {
  local ticket_id="" board_id=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board) board_id="${2:?Missing value for --board}"; shift 2 ;;
      *)
        if [[ -z "$ticket_id" ]]; then
          ticket_id="$1"; shift
        else
          die "Unknown option: $1"
        fi
        ;;
    esac
  done

  [[ -n "$ticket_id" ]] || die "Usage: fleex ticket comments <id> [--board ID]"

  local uuid; uuid="$(_resolve_ticket_id "$ticket_id" "$board_id")"
  local base; base="$(_api_base)"

  local comments; comments="$(_api_get "$base/api/tickets/$uuid/comments")"
  local count; count="$(echo "$comments" | jq 'length')"

  if [[ "$count" -eq 0 ]]; then
    info "No comments on this ticket."
    return
  fi

  echo ""
  echo "$comments" | jq -r '.[] |
    "\(.authorType)\t\(.authorName)\t\(.createdAt)\t\(.body)"
  ' | while IFS=$'\t' read -r author_type author_name created_at body; do
    local color="$NC"
    [[ "$author_type" == "agent" ]] && color="$CYAN"
    [[ "$author_type" == "user" ]] && color="$GREEN"

    printf "  ${color}${BOLD}%s${NC} ${DIM}(%s)${NC}  ${DIM}%s${NC}\n" "$author_name" "$author_type" "$created_at"
    echo "$body" | while IFS= read -r line; do
      printf "    %s\n" "$line"
    done
    echo ""
  done
}

# ── Epic commands ──────────────────────────────────────────────────────────────

cmd_epic() {
  _check_jq
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list|ls)       _epic_list "$@" ;;
    show|view)     _epic_show "$@" ;;
    help|--help|-h) _epic_help ;;
    *)
      err "Unknown epic command: $subcmd"
      _epic_help
      exit 1
      ;;
  esac
}

_epic_list() {
  local board_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --board)  board_id="${2:?Missing value for --board}"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done

  local base; base="$(_api_base)"
  local url="$base/api/epics"
  [[ -n "$board_id" ]] && url="$url?boardId=$board_id"

  local epics; epics="$(_api_get "$url")"
  local count; count="$(echo "$epics" | jq 'length')"

  if [[ "$count" -eq 0 ]]; then
    info "No epics found."
    return
  fi

  # Sort by timeframe (now → next → later → null), then name
  epics="$(echo "$epics" | jq '
    def tf_order: if . == "now" then 0 elif . == "next" then 1 elif . == "later" then 2 else 3 end;
    sort_by([(.timeframe // "zzz" | tf_order), .name])
  ')"

  echo ""
  printf "  ${BOLD}%-10s %-11s %-11s %-6s %s${NC}\n" "ID" "Status" "Timeframe" "Emoji" "Name"
  printf "  %-10s %-11s %-11s %-6s %s\n" "──────────" "───────────" "───────────" "──────" "─────────────────────────────"

  echo "$epics" | jq -r '.[] | "\(.id | .[0:8])\t\(.groupStatus // "active")\t\(.timeframe // "-")\t\(.emoji // "-")\t\(.name)"' | \
  while IFS=$'\t' read -r short_id gstatus timeframe emoji name; do
    local color=""
    case "$gstatus" in
      active)   color="$GREEN" ;;
      archived) color="$DIM" ;;
      done)     color="$GREEN" ;;
      *)        ;;
    esac
    printf "  %-10s %s%-11s%s %-11s %-6s %s\n" "$short_id" "$color" "$gstatus" "$NC" "$timeframe" "$emoji" "$name"
  done
  echo ""
  info "$count epic(s)"
}

_epic_show() {
  local epic_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      *)
        if [[ -z "$epic_id" ]]; then
          epic_id="$1"; shift
        else
          die "Unknown option: $1"
        fi
        ;;
    esac
  done

  [[ -n "$epic_id" ]] || die "Usage: fleex epic show <id>"

  local base; base="$(_api_base)"

  # Resolve short ID (8 chars prefix) to full UUID
  local resolved_id="$epic_id"
  if [[ ${#epic_id} -lt 36 ]]; then
    local all_epics; all_epics="$(_api_get "$base/api/epics")"
    resolved_id="$(echo "$all_epics" | jq -r --arg prefix "$epic_id" '[.[] | select(.id | startswith($prefix))] | .[0].id // empty')"
    [[ -n "$resolved_id" ]] || die "Epic not found: $epic_id"
  fi

  local epic; epic="$(_api_get "$base/api/epics/$resolved_id")"

  local name gstatus timeframe color emoji description created updated uuid blocked favorite
  name="$(echo "$epic" | jq -r '.name')"
  gstatus="$(echo "$epic" | jq -r '.groupStatus // "active"')"
  timeframe="$(echo "$epic" | jq -r '.timeframe // "-"')"
  color="$(echo "$epic" | jq -r '.color // "-"')"
  emoji="$(echo "$epic" | jq -r '.emoji // ""')"
  description="$(echo "$epic" | jq -r '.description // ""')"
  created="$(echo "$epic" | jq -r '.createdAt // "-"')"
  updated="$(echo "$epic" | jq -r '.updatedAt // "-"')"
  uuid="$(echo "$epic" | jq -r '.id')"
  blocked="$(echo "$epic" | jq -r '.blocked // false')"
  favorite="$(echo "$epic" | jq -r '.favorite // false')"

  # Fetch board names
  local board_ids; board_ids="$(echo "$epic" | jq -r '(.boardIds // []) | join(",")')"
  local boards_display="-"
  if [[ -n "$board_ids" && "$board_ids" != "" ]]; then
    local all_boards; all_boards="$(_api_get "$base/api/boards")"
    boards_display="$(echo "$epic" | jq -r --argjson boards "$all_boards" '
      [.boardIds[] as $bid | ($boards | map(select(.id == $bid)) | .[0]) | "\(.id | .[0:8]) (\(.name // "Unknown"))"] | join(", ")
    ')"
  fi

  local display_emoji=""
  [[ -n "$emoji" && "$emoji" != "null" && "$emoji" != "" ]] && display_emoji="$emoji "

  echo ""
  printf "  ${BOLD}Epic %s%s${NC}\n" "$display_emoji" "$name"
  printf "  %s\n" "─────────────────────────────────────────────────────────"
  printf "  ${BOLD}Status:${NC}       %s\n" "$gstatus"
  printf "  ${BOLD}Timeframe:${NC}    %s\n" "$timeframe"
  printf "  ${BOLD}Color:${NC}        %s\n" "$color"
  printf "  ${BOLD}Boards:${NC}       %s\n" "$boards_display"
  printf "  ${BOLD}Blocked:${NC}      %s\n" "$blocked"
  printf "  ${BOLD}Favorite:${NC}     %s\n" "$favorite"
  printf "  ${BOLD}Created:${NC}      %s\n" "$created"
  printf "  ${BOLD}Updated:${NC}      %s\n" "$updated"
  printf "  ${BOLD}UUID:${NC}         ${DIM}%s${NC}\n" "$uuid"

  if [[ -n "$description" && "$description" != "null" && "$description" != "" ]]; then
    echo ""
    printf "  ${BOLD}Description:${NC}\n"
    echo "$description" | while IFS= read -r line; do
      printf "    %s\n" "$line"
    done
  fi

  # Fetch and display tickets
  local tickets; tickets="$(_api_get "$base/api/epics/$resolved_id/tickets")"
  local ticket_count; ticket_count="$(echo "$tickets" | jq 'length')"

  echo ""
  printf "  ${BOLD}Tickets (%s):${NC}\n" "$ticket_count"

  if [[ "$ticket_count" -gt 0 ]]; then
    echo "$tickets" | jq -r 'sort_by(.displayId) | .[] | "\(.displayId)\t\(.status)\t\(.priority)\t\(.type // "-")\t\(.title)"' | \
    while IFS=$'\t' read -r did status_val prio ttype title; do
      local padded_status; printf -v padded_status "%-11s" "$status_val"
      local scolor; scolor="$(_status_color_code "$status_val")"
      printf "    #%-5s %s%s%s %-8s %-8s %s\n" "$did" "$scolor" "$padded_status" "$NC" "$prio" "$ttype" "$title"
    done
  else
    printf "    ${DIM}No tickets${NC}\n"
  fi
  echo ""
}

