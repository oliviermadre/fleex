{
  "name": "agent-session-manager",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "postinstall": "chmod +x node_modules/.bun/node-pty@*/node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "dev": "trap 'kill 0' INT; bun run dev:server & bun run dev:web & wait",
    "dev:server": "cd packages/server && bun run dev",
    "dev:web": "cd packages/web && bun run dev",
    "build": "cd packages/shared && bun run build && cd ../web && bun run build && cd ../server && bun run build",
    "start": "NODE_ENV=production node packages/server/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
